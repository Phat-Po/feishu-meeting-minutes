# 复制成 .env 然后填。.env 已经在 .gitignore 里，不会被提交。
# 这个文件本身不会自动加载，需要你 export 或者交给 launchd / cron / docker 注入。

# ── 模型：二选一 ─────────────────────────────────────────
# 方式一：Anthropic 兼容接口（下面三个一起填）
AI_BASE_URL=https://api.anthropic.com
AI_API_KEY=sk-ant-xxxxxxxx
AI_MODEL=claude-sonnet-5-5

# 方式二：自己的命令（设了它就忽略上面三个）
# 逐字稿从 stdin 进，纪要从 stdout 出，失败要返回非 0 退出码。
# SUMMARY_CMD=claude -p
# SUMMARY_CMD=codex exec -
# SUMMARY_CMD=ollama run qwen3

# ── 账号 ────────────────────────────────────────────────
# 要扫哪些账号，逗号分隔。不填就用当前登录的那个。
# 用 `lark-cli profile list` 查账号名。
# LARK_PROFILES=cli_xxxxxxxx,cli_yyyyyyyy

# 卡片固定发给谁（open_id）。不填就发给每个账号自己。
# OPERATOR_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 过滤 ────────────────────────────────────────────────
# 录音短于多少秒跳过（默认 120）。误触录的那些一秒钟文件就靠它挡掉。
# MIN_DURATION=120

# 逐字稿短于多少字跳过（默认 600）
# MIN_CHARS=600

# ── 长会议 ──────────────────────────────────────────────
# 逐字稿超过多少字开始分块提炼（默认 30000）
# CHUNK_ABOVE=30000

# 每块目标字数（默认 14000）
# CHUNK_SIZE=14000

# 模型单次输出上限（默认 32000）。推理模型会先输出思考块，额度小了正文出不来
# AI_MAX_TOKENS=32000

# ── 其他 ────────────────────────────────────────────────
# 自定义提示词文件
# PROMPT_FILE=./my-prompt.txt

# 已处理记录存哪（默认脚本同目录 state.json）
# STATE_FILE=./state.json

# lark-cli 不在 PATH 里时指定绝对路径
# LARK_CLI=/usr/local/bin/lark-cli
